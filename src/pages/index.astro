---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../config/site';
import { getPublicProjects, getPublicWriting, getPublicMedia } from '../lib/content';

const [projects, writing, media] = await Promise.all([getPublicProjects(), getPublicWriting(), getPublicMedia()]);
const bio = site.bio.trim();
---
<SiteLayout description={bio || undefined}>
  <header class="intro">
    <h1>{site.displayName}</h1>
    {bio && <p class="bio">{bio}</p>}
    <nav class="social-links" aria-label="Social links">
      {site.socialLinks.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
  </header>
  <section aria-labelledby="projects">
    <h2 id="projects" class="section-heading">Projects:</h2>
    {projects.length > 0 && <ul class="project-list">
      {projects.map(({ data }) => <li>
        <a href={data.externalUrl ?? `/projects/${data.slug}/`}>{data.title}</a>
        {data.description && <p>{data.description}</p>}
      </li>)}
    </ul>}
  </section>
  <hr />
  <section aria-labelledby="writing">
    <h2 id="writing" class="section-heading">Writing:</h2>
    {writing.length > 0 && <ul class="writing-list">
      {writing.map(({ data }) => <li><a href={`/writing/${data.slug}/`}>{data.title}</a></li>)}
    </ul>}
  </section>
  <hr />
  <section aria-labelledby="media">
    <h2 id="media" class="section-heading">Media:</h2>
    {media.some(entry => entry.data.items.length > 0) && <div class="media-grid">
      {media.flatMap(({ data }) => data.items.map(item => <figure>
        {item.kind === 'image'
          ? <a href={item.src} aria-label={item.alt || item.caption || 'Open image'}><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /></a>
          : item.kind === 'video'
            ? <video src={item.src} controls preload="none" playsinline aria-label={item.alt || item.caption || 'Video'} />
            : <audio src={item.src} controls preload="none" aria-label={item.alt || item.caption || 'Audio'} />}
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>))}
    </div>}
  </section>
</SiteLayout>