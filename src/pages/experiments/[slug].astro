---
import { render, type CollectionEntry } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { getPublicExperiments } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPublicExperiments()).filter(entry => entry.data.slug).map(entry => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}
interface Props { entry: CollectionEntry<'experiments'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ReadingLayout {...entry.data}><Content /></ReadingLayout>